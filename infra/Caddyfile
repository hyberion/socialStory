# Production reverse proxy. Caddy gets and renews HTTPS certificates
# automatically. Replace the two hostnames with your real (sub)domains,
# both pointed at the droplet's IP with A records.

user.example.com {
	encode gzip
	handle /api/* {
		reverse_proxy api:8787
	}
	handle {
		root * /srv/user-web
		try_files {path} /index.html
		file_server
	}
}

play.example.com {
	encode gzip
	handle /api/* {
		reverse_proxy api:8787
	}
	handle {
		root * /srv/player-app
		try_files {path} /index.html
		file_server
	}
}
