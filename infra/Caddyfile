# Production reverse proxy. Caddy gets and renews HTTPS certificates
# automatically. The two hostnames come from .env (USER_HOST, PLAY_HOST),
# both pointed at the droplet's IP with A records.

(app) {
	encode gzip
	header {
		# Standard hygiene: no framing by other sites, no sniffing, no referrer leaks.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
	handle /api/* {
		# Photos and recordings go up through here; the API checks sizes itself.
		request_body {
			max_size 20MB
		}
		reverse_proxy api:8787
	}
}

{$USER_HOST:app.newmythology.net} {
	import app
	handle {
		root * /srv/user-web
		try_files {path} /index.html
		file_server
	}
}

{$PLAY_HOST:play.newmythology.net} {
	import app
	handle {
		root * /srv/player-app
		try_files {path} /index.html
		file_server
	}
}
