# Copy this file to .env (which git ignores) and fill in real values.
#   PowerShell:  Copy-Item .env.example .env

# --- Meta Model API ---
# Use the dedicated app key (e.g. "asd-app-dev"), not your Muse Code key.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=socialstory
POSTGRES_PASSWORD=socialstory
POSTGRES_DB=socialstory
DATABASE_URL=postgres://socialstory:socialstory@localhost:5432/socialstory

# --- API server ---
API_PORT=8787
