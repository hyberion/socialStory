{
  "name": "@socialstory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend: the only service that talks to the Meta Model API.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@socialstory/core": "workspace:*",
    "hono": "^4.10.1",
    "openai": "^6.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
