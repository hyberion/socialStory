{
  "name": "@socialstory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend: the only service that talks to the Meta Model API.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "write-story": "tsx src/scripts/writeStory.ts",
    "compare-effort": "tsx src/scripts/compareEffort.ts",
    "draw-story": "tsx src/scripts/drawStory.ts",
    "photo-list": "tsx src/scripts/photoList.ts",
    "publish-kit": "tsx src/scripts/publishKit.ts",
    "narrate": "tsx src/scripts/narrate.ts",
    "demo-data": "tsx src/scripts/demoData.ts",
    "voice-questions": "tsx src/scripts/voiceQuestions.ts",
    "style-test": "tsx src/scripts/styleTest.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@hono/node-ws": "^1.3.1",
    "@meta-sam/parser": "^0.1.0",
    "@socialstory/core": "workspace:*",
    "hono": "^4.10.1",
    "openai": "^6.5.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
