{
  "name": "socialstory",
  "private": true,
  "version": "0.1.0",
  "description": "Personalized prep journeys that help autistic kids get ready for new or hard moments.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @socialstory/api dev",
    "dev:user": "pnpm --filter @socialstory/user-web dev",
    "dev:player": "pnpm --filter @socialstory/player-app dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "smoke": "pnpm --filter @socialstory/api smoke",
    "write-story": "pnpm --filter @socialstory/api write-story",
    "compare-effort": "pnpm --filter @socialstory/api compare-effort",
    "draw-story": "pnpm --filter @socialstory/api draw-story"
  }
}
